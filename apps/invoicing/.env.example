# Invoicing Engine — environment template
# Copy to .env locally; in Railway set via dashboard env vars.

# Server
PORT=3001
NODE_ENV=development

# Firebase Admin (Faz 1.3+ kullanir)
# Tek satir JSON; Railway env'inde encoded olarak set edilir.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Redis (Token cache + queue — Faz 1.3 + Faz 2)
REDIS_URL=

# Sentry (Faz 4.1 aktive edilecek — bos birakilirsa no-op)
SENTRY_DSN=

# Encryption — Parasut credentials AES-256-GCM master key (Faz 1.4)
# 32 byte hex (64 hex char). openssl rand -hex 32 ile uretilir.
INVOICING_AES_MASTER_KEY=
