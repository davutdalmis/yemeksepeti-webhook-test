# YemiGO Webhook Server - Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!

# ==================== REQUIRED API KEYS ====================
# Server will NOT start without these - no fallback values!

# YemekSepeti polling API key - WPF uses this to authenticate polling requests
YEMEKSEPETI_POLLING_API_KEY=your-secure-key-here

# GetirYemek polling API key - WPF uses this to poll webhooks
GETIRYEMEK_POLLING_API_KEY=your-secure-key-here

# GetirYemek default restaurant secret (fallback for webhooks)
GETIRYEMEK_DEFAULT_RESTAURANT_SECRET=your-secret-here

# ==================== OPTIONAL ====================

# YemekSepeti API Credentials (for order validation - optional)
# ChainCode (örn: BFettTsT)
# YEMEKSEPETI_CHAIN_CODE=

# Username (örn: me-tr-plugin-xxx-001)
# YEMEKSEPETI_USERNAME=

# Password (PGP ile şifrelenmiş olarak gelir)
# YEMEKSEPETI_PASSWORD=

# API Base URL (staging veya production)
# Staging: https://integration-middleware.stg.restaurant-partners.com
# Production: https://integration-middleware.restaurant-partners.com
# YEMEKSEPETI_BASE_URL=https://integration-middleware.stg.restaurant-partners.com

# Sipariş kontrol aralığı (dakika)
# YEMEKSEPETI_CHECK_INTERVAL_MINUTES=5

# Server port (Railway sets this automatically)
# PORT=3000
