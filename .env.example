# ================================================================================
# YEMIGO CLOUD-FIRST WEBHOOK SERVER v3.0.0 - ENVIRONMENT VARIABLES
# ================================================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# Railway'de bu değerler Environment Variables olarak ayarlanır.
# NEVER commit .env file to git!
# ================================================================================

# ==================== ZORUNLU API KEY'LER ====================
# WPF polling authentication için kullanılır

YEMEKSEPETI_POLLING_API_KEY=your-yemeksepeti-polling-key-here
GETIRYEMEK_POLLING_API_KEY=your-getiryemek-polling-key-here

# Opsiyonel: GetirYemek default restaurant secret (webhook'larda header yoksa kullanılır)
GETIRYEMEK_DEFAULT_RESTAURANT_SECRET=

# ==================== FIREBASE CONFIGURATION (YENİ!) ====================
# Firebase Admin SDK için - AŞAĞIDAKİ YÖNTEMLERDEN BİRİNİ KULLANIN:

# YÖNTEM 1: JSON string olarak (Railway için önerilen)
# Service Account JSON'ı tek satır olarak yapıştırın:
# Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_JSON=

# YÖNTEM 2: Dosya yolu olarak
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-credentials.json

# YÖNTEM 3: Local development için
# firebase-credentials.json dosyasını proje kök dizinine koyun

# ==================== DEFAULT BRANCH (YENİ!) ====================
# Webhook'larda branchId belirtilmezse kullanılır
DEFAULT_BRANCH_ID=

# ==================== YEMEKSEPETI API (Opsiyonel) ====================
# Sipariş validasyonu için - YemekSepeti API credentials

# ChainCode (örn: BFettTsT)
YEMEKSEPETI_CHAIN_CODE=

# Username (örn: me-tr-plugin-xxx-001)
YEMEKSEPETI_USERNAME=

# Password (PGP ile şifrelenmiş olarak gelir)
YEMEKSEPETI_PASSWORD=

# API Base URL (staging veya production)
# Staging: https://integration-middleware.stg.restaurant-partners.com
# Production: https://integration-middleware.restaurant-partners.com
YEMEKSEPETI_BASE_URL=https://integration-middleware.stg.restaurant-partners.com

# Sipariş kontrol aralığı (dakika)
YEMEKSEPETI_CHECK_INTERVAL_MINUTES=5

# ==================== SERVER ====================
# Server port (Railway sets this automatically)
PORT=3000

# ================================================================================
# RAILWAY DEPLOYMENT ADIM ADIM:
# ================================================================================
#
# 1. Firebase Service Account JSON alın:
#    - Firebase Console > Project Settings > Service Accounts
#    - "Generate New Private Key" tıklayın
#    - JSON dosyası indirilecek
#
# 2. JSON'ı tek satıra çevirin (online tool kullanabilirsiniz):
#    - https://www.textfixer.com/tools/remove-line-breaks.php
#
# 3. Railway Dashboard'da:
#    - Settings > Variables bölümüne gidin
#    - FIREBASE_SERVICE_ACCOUNT_JSON = (tek satır JSON)
#    - Diğer değişkenleri de ekleyin
#
# 4. Deploy edin
#
# ================================================================================
# MİMARİ AÇIKLAMA:
# ================================================================================
#
# v3.0.0 PARALEL ÇALIŞMA:
#
#   Webhook Geldi
#        │
#        ├─► ESKİ YOL: Queue'ya ekle → WPF Polling → Firebase (WPF açıkken)
#        │
#        └─► YENİ YOL: Firebase'e direkt yaz (WPF kapalı olsa bile!)
#
# AVANTAJLAR:
# - WPF kapalı olsa bile siparişler Firebase'e yazılır
# - Kurye uygulaması kesintisiz çalışır
# - Mevcut WPF sistemi bozulmaz (geriye uyumluluk)
# - SmartDispatch algoritması cloud'da çalışır
# - Push notification cloud'dan gönderilir
#
# ================================================================================
